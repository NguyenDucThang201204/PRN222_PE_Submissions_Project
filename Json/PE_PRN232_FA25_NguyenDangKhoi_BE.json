	"item": [
		{
			"name": "Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response has token\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.token).to.be.a('string');\r",
							"    pm.expect(jsonData.token.length).to.be.above(0);\r",
							"    \r",
							"    // Lưu token vào environment variable\r",
							"    pm.environment.set(\"jwt_token\", jsonData.token);\r",
							"});\r",
							"\r",
							"pm.test(\"Response has role\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.role).to.exist;\r",
							"});\r",
							"\r",
							"pm.test(\"Response structure is valid\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData).to.have.property('token');\r",
							"    pm.expect(jsonData).to.have.property('role');\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"userName\": {{email_correct1}},\r\n  \"password\": {{password_correct1}}\r\n}",
					"options": {
