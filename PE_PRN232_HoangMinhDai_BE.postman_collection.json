		{
			"name": "Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Login_Failed\r",
							"pm.test(\"Login Failed\", function () {\r",
							"    pm.expect(pm.response.code).to.equal(401);\r",
							"    const response = pm.response.json();\r",
							"    pm.expect(response.errorCode).to.equal(\"HB40101\");\r",
							"    pm.expect(response.message).to.equal(\"Token missing/invalid\");\r",
							"});\r",
							"\r",
							"// Login_Pass  \r",
							"pm.test(\"Login Success\", function () {\r",
							"    pm.expect(pm.response.code).to.equal(200);\r",
							"    const response = pm.response.json();\r",
							"    pm.expect(response).to.have.property('token');\r",
							"    pm.expect(response).to.have.property('role');\r",
							"    // Save token for subsequent requests\r",
							"    pm.environment.set(\"token\", response.token);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
