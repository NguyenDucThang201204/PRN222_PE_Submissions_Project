{
  "openapi": "3.0.1",
  "info": {
    "title": "Bear API",
    "description": "JWT Authentication",
    "version": "v1"
  },
  "paths": {
    "/Accounts/Login": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/BearProfiles": {
      "post": {
        "tags": [
          "BearProfiles"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BearDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/BearDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/BearDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "BearProfiles"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/BearProfiles/{id}": {
      "get": {
        "tags": [
          "BearProfiles"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BearDto": {
        "type": "object",
        "properties": {
          "bearTypeId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "bearName": {
            "type": "string",
            "nullable": true
          },
          "beartWeight": {
            "type": "number",
            "format": "double"
          },
          "characteristics": {
            "type": "string",
            "nullable": true
          },
          "careNeeds": {
            "type": "string",
            "nullable": true
          },
          "modifiedDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "userName": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "**Bearer your_token_here**",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}